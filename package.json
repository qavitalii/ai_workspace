{
  "name": "ai-workspace",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k 'tsx watch src/server/main.ts' 'vite --host 127.0.0.1'",
    "dev:server": "tsx watch src/server/main.ts",
    "build": "tsc --noEmit && vite build && node ops/build.mjs",
    "start": "node dist/node/server/main.js",
    "setup": "tsx src/server/setup.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "argon2": "^0.44.0",
    "dockerode": "^5.0.1",
    "fastify": "^5.12.8",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "otpauth": "^9.4.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.3",
    "yaml": "^2.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.43",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^5.1.0"
  },
  "license": "GPL-3.0-only"
}
