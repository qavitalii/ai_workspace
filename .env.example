DATABASE_URL=postgres://workspace:change-me@localhost:5432/workspace
APP_ORIGIN=http://localhost:5173
# The installer sets these for Docker deployments. For public IP HTTPS use
# CADDY_CONFIG=Caddyfile.ip and TLS_SERVER_NAME=the public IP (no IPv6 brackets).
# SITE_ADDRESS uses brackets around IPv6, as does the host in APP_ORIGIN.
# CADDY_CONFIG=Caddyfile
# TLS_SERVER_NAME=
# Direct development access trusts no forwarded headers. Compose supplies Caddy's IP.
TRUSTED_PROXY_IPS=
# Initial shared output budget; subsequent changes are saved in Server settings.
OUTPUT_LIMIT_GB=1
# Initial limit for installed tools in each project's /env.
PROJECT_ENV_LIMIT_GIB=8
# Change these addresses and subnet together if they overlap your network.
WORKSPACE_PROXY_IP=172.30.250.2
WORKSPACE_SERVER_PROXY_IP=172.30.250.3
WORKSPACE_PROXY_SUBNET=172.30.250.0/24
PORT=3000
DATA_ROOT=/srv/ai-workspace/data
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Production requires https; use development only on localhost.
NODE_ENV=development
RUNNER_IMAGE=ai-workspace-runner:0.1.0
# Initial default. Settings → Resources can override this with any positive integer.
MAX_CONCURRENT=3
MAX_FILE_MB=25
MAX_ATTACHMENTS=10
# Enable only after live verification with your own accounts and provider terms.
ENABLE_AUTO_HANDOFF=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
